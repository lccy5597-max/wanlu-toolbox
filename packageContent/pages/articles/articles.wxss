@import "../../../styles/theme.wxss";
@import "../../../styles/common.wxss";

page {
  height: 100vh;
  overflow: hidden;
  background: var(--wl-bg);
}

.page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  overflow: hidden;
  padding: 0;
}

.page-scroll {
  flex: 1;
  height: 0;
  min-height: 0;
}

.content {
  padding: 8rpx var(--wl-page-padding) calc(48rpx + var(--wl-safe-bottom));
}

.intro {
  padding: 28rpx 24rpx;
  background: linear-gradient(180deg, var(--wl-primary-weak) 0%, var(--wl-surface) 100%);
  border: 1rpx solid var(--wl-primary-light);
}

.intro-title {
  color: var(--wl-text);
  font-size: var(--wl-font-xl);
  font-weight: 700;
}

.intro-desc {
  margin-top: 10rpx;
  color: var(--wl-text-sub);
  font-size: var(--wl-font-sm);
  line-height: 1.6;
}

.fallback-hint {
  margin-top: var(--wl-space-sm);
  padding: 14rpx 20rpx;
  border-radius: var(--wl-radius-sm);
  background: var(--wl-primary-weak);
  color: var(--wl-primary-dark);
  font-size: var(--wl-font-xs);
  text-align: center;
}

.state-card {
  margin-top: var(--wl-space);
  padding: 36rpx 24rpx;
  text-align: center;
}

.loading-indicator {
  width: 36rpx;
  height: 36rpx;
  margin: 0 auto;
  border: 4rpx solid var(--wl-primary-light);
  border-top-color: var(--wl-primary);
  border-radius: 50%;
  animation: content-spin 0.8s linear infinite;
}

.state-title {
  margin-top: 18rpx;
  color: var(--wl-text-sub);
  font-size: var(--wl-font-sm);
}

.retry-button {
  min-width: 176rpx;
  min-height: 72rpx;
  margin-top: 20rpx;
  padding: 0 28rpx;
  border-radius: var(--wl-radius-pill);
  background: var(--wl-primary);
  color: var(--wl-text-inverse);
  font-size: var(--wl-font-sm);
  line-height: 72rpx;
}

.retry-button.compact {
  min-width: 152rpx;
  min-height: 64rpx;
  margin-top: 12rpx;
  line-height: 64rpx;
}

.article-list {
  margin-top: var(--wl-space);
}

.article-card {
  display: flex;
  align-items: stretch;
  min-height: 180rpx;
  margin-bottom: var(--wl-card-gap);
}

.article-card-active {
  opacity: 0.86;
}

.article-cover {
  flex: none;
  width: 190rpx;
  min-height: 180rpx;
  background: var(--wl-surface-sub);
}

.article-body {
  flex: 1;
  min-width: 0;
  padding: 22rpx 24rpx;
}

.article-title {
  color: var(--wl-text);
  font-size: var(--wl-font-md);
  font-weight: 600;
  line-height: 1.45;
}

.article-excerpt {
  margin-top: 10rpx;
  color: var(--wl-text-sub);
  font-size: var(--wl-font-sm);
  line-height: 1.55;
}

.article-meta {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  margin-top: 14rpx;
  color: var(--wl-text-weak);
  font-size: var(--wl-font-xs);
  line-height: 1.5;
}

.article-category {
  color: var(--wl-primary-dark);
}

.meta-separator {
  margin: 0 8rpx;
}

.article-author {
  max-width: 220rpx;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.list-footer {
  padding: 8rpx 0 20rpx;
  text-align: center;
}

.footer-text {
  color: var(--wl-text-weak);
  font-size: var(--wl-font-sm);
}

.load-more-error {
  display: flex;
  flex-direction: column;
  align-items: center;
}

@keyframes content-spin {
  from { transform: rotate(0deg); }
  to { transform: rotate(360deg); }
}
