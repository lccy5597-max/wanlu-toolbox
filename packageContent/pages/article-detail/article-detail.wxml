<view class="page">
  <navigation-bar title="文章详情" back="{{true}}"></navigation-bar>

  <scroll-view class="page-scroll" scroll-y enhanced show-scrollbar="{{false}}">
    <view class="content">
      <view wx:if="{{status === 'loading'}}" class="state-card card">
        <view class="loading-indicator"></view>
        <view class="state-title">正在加载内容</view>
      </view>

      <view wx:elif="{{status === 'unavailable' || status === 'invalid' || status === 'not_found'}}" class="state-card card">
        <empty-state icon="info-circle" title="{{errorView.title}}" desc="{{errorView.description}}" size="compact" />
      </view>

      <view wx:elif="{{status === 'error'}}" class="state-card card">
        <empty-state icon="info-circle" title="{{errorView.title}}" desc="{{errorView.description}}" size="compact">
          <button wx:if="{{errorView.retryable}}" class="retry-button" bindtap="onRetry">重新加载</button>
        </empty-state>
      </view>

      <view wx:elif="{{status === 'success' && article}}" class="article-detail">
        <view wx:if="{{isFallback}}" class="fallback-hint">当前显示缓存内容</view>
        <image
          wx:if="{{article.coverVisible}}"
          class="article-cover"
          src="{{article.cover}}"
          mode="widthFix"
          binderror="onCoverError"
        />

        <view class="article-head card">
          <view class="article-title">{{article.title}}</view>
          <view class="article-meta">
            <text class="article-category">{{article.category}}</text>
            <text wx:if="{{article.displayPublishTime}}" class="meta-separator">·</text>
            <text wx:if="{{article.displayPublishTime}}">{{article.displayPublishTime}}</text>
            <text wx:if="{{article.author}}" class="meta-separator">·</text>
            <text wx:if="{{article.author}}">{{article.author}}</text>
          </view>
        </view>

        <view class="article-content card">
          <rich-text class="article-rich-text" nodes="{{article.content}}"></rich-text>
        </view>
      </view>
    </view>
  </scroll-view>
</view>
