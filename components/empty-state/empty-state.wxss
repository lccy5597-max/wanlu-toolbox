.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 72rpx 40rpx;
  text-align: center;
}

.empty-state.is-compact {
  padding: 40rpx 24rpx;
}

.empty-title {
  margin-top: 20rpx;
  font-size: var(--wl-font);
  color: var(--wl-text-sub);
}

.empty-desc {
  margin-top: 10rpx;
  font-size: var(--wl-font-sm);
  color: var(--wl-text-weak);
  line-height: 1.6;
}
