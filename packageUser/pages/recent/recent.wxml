<view class="shell"><navigation-bar title="最近使用" back="{{true}}"></navigation-bar><scroll-view class="page-scroll" scroll-y enhanced show-scrollbar="{{false}}"><view class="content"><view class="page-head"><view><view class="page-title">最近使用</view><view class="page-desc">只有工具核心操作真正成功后才会进入这里。</view></view><view wx:if="{{items.length}}" class="clear-link" bindtap="onClear">清空</view></view><view wx:if="{{items.length}}"><view wx:for="{{items}}" wx:key="id" class="tool-card card" data-path="{{item.path}}" bindtap="onToolTap"><view class="tool-icon icon-wrap tone-{{item.tone}}"><t-icon name="{{item.icon}}" size="38rpx" color="{{item.iconColor}}" /></view><view class="tool-copy"><view class="tool-name">{{item.name}}</view><view class="tool-meta">{{item.timeText}} · 累计成功使用 {{item.useCount}} 次</view></view><t-icon name="chevron-right" size="28rpx" color="#94a0a5" /></view></view><empty-state wx:else title="暂无最近使用" desc="成功完成一次工具操作后，会显示在这里。" size="compact" /></view></scroll-view></view>
