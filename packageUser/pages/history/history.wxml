<view class="shell"><navigation-bar title="浏览记录" back="{{true}}"></navigation-bar><scroll-view class="page-scroll" scroll-y enhanced show-scrollbar="{{false}}"><view class="content"><view class="page-head"><view><view class="page-title">浏览记录</view><view class="page-desc">只记录打开过的正式工具，不保存工具输入内容。</view></view><view wx:if="{{items.length}}" class="clear-link" bindtap="onClear">清空</view></view><view wx:if="{{items.length}}"><view wx:for="{{items}}" wx:key="id" class="data-card card"><view class="tool-main" data-path="{{item.path}}" bindtap="onToolTap"><view class="tool-icon icon-wrap tone-{{item.tone}}"><t-icon name="{{item.icon}}" size="38rpx" color="{{item.iconColor}}" /></view><view class="tool-copy"><view class="tool-name">{{item.name}}</view><view class="tool-meta">{{item.timeText}} · 浏览 {{item.viewCount}} 次</view></view><t-icon name="chevron-right" size="28rpx" color="#94a0a5" /></view><view class="card-action" data-id="{{item.id}}" bindtap="onRemove">删除记录</view></view></view><empty-state wx:else title="暂无浏览记录" desc="打开正式工具后，会在这里留下本机浏览记录。" size="compact" /></view></scroll-view></view>
