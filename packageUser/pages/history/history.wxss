@import "../../../styles/theme.wxss";
@import "../../../styles/common.wxss";
page,.shell{height:100vh;overflow:hidden;background:var(--wl-bg)}.shell{display:flex;flex-direction:column}.page-scroll{flex:1;height:0;min-height:0}.content{padding:24rpx var(--wl-page-padding) calc(48rpx + var(--wl-safe-bottom))}.page-head{display:flex;align-items:flex-start;justify-content:space-between;margin-bottom:20rpx}.page-title{font-size:var(--wl-font-lg);font-weight:600;color:var(--wl-text)}.page-desc{margin-top:8rpx;font-size:var(--wl-font-sm);color:var(--wl-text-weak);line-height:1.6}.clear-link{padding:10rpx 0 10rpx 24rpx;color:#b4472c;font-size:var(--wl-font-sm)}.data-card{margin-bottom:16rpx;padding:0 24rpx}.tool-main{display:flex;align-items:center;padding:24rpx 0}.tool-icon{width:72rpx;height:72rpx;margin-right:18rpx}.tool-copy{flex:1;min-width:0}.tool-name{font-size:var(--wl-font-md);font-weight:500;color:var(--wl-text)}.tool-meta{margin-top:6rpx;font-size:var(--wl-font-sm);color:var(--wl-text-weak)}.card-action{padding:18rpx 0;border-top:1rpx solid var(--wl-border);text-align:right;color:var(--wl-primary-dark);font-size:var(--wl-font-sm)}
