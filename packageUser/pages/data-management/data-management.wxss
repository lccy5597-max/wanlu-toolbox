@import "../../../styles/theme.wxss";
@import "../../../styles/common.wxss";
page,.shell{height:100vh;overflow:hidden;background:var(--wl-bg)}.shell{display:flex;flex-direction:column}.page-scroll{flex:1;height:0;min-height:0}.content{padding:24rpx var(--wl-page-padding) calc(48rpx + var(--wl-safe-bottom))}.notice-card{padding:28rpx}.notice-title{font-size:var(--wl-font-lg);font-weight:600;color:var(--wl-text)}.notice-desc{margin-top:10rpx;color:var(--wl-text-sub);font-size:var(--wl-font-sm);line-height:1.7}.summary-row{display:flex;gap:24rpx;margin-top:22rpx;color:var(--wl-primary-dark);font-size:var(--wl-font-sm)}.action-list{margin-top:var(--wl-card-gap);padding:0 24rpx}.action-row{display:flex;align-items:center;padding:24rpx 0}.action-row:not(.is-last){border-bottom:1rpx solid var(--wl-border)}.action-copy{flex:1;min-width:0}.action-title{font-size:var(--wl-font-md);font-weight:500;color:var(--wl-text)}.action-title.is-danger{color:#b4472c}.action-desc{margin-top:6rpx;color:var(--wl-text-weak);font-size:var(--wl-font-sm)}.foot-note{padding:28rpx 12rpx;color:var(--wl-text-weak);font-size:var(--wl-font-xs);line-height:1.7}
