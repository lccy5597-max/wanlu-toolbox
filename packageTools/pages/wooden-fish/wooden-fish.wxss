/* 电子木鱼 —— 已按「挽鹿工具箱」统一设计规范重构视觉：
   浅色背景 + 品牌色 + 统一卡片圆角/按钮高度/字体层级 + 底部安全区。
   骨架为 .shell / .page-scroll / .page（与其他工具页一致），
   功能结构与 JS 逻辑未改动。 */

page {
  height: 100vh;
  overflow: hidden;
  background: var(--bg-page);
  color: var(--text-primary);
}

.shell {
  display: flex;
  flex-direction: column;
  height: 100vh;
  overflow: hidden;
  background: var(--bg-page);
}

.page-scroll {
  flex: 1;
  height: 0;
  min-height: 0;
  background: var(--bg-page);
}

.page {
  min-height: 100%;
  padding: var(--space-md) var(--wl-page-padding) calc(48rpx + var(--wl-safe-bottom));
  box-sizing: border-box;
  background: var(--bg-page);
}

/* 说明条里的木鱼图标 */
.hero-fish-image {
  width: 52rpx;
  height: 40rpx;
}

/* 计数统计 */
.stats-row {
  display: flex;
  align-items: stretch;
  margin-top: var(--wl-card-gap);
  padding: var(--space-md) 12rpx;
  border: 1rpx solid var(--border-color);
  border-radius: var(--radius-large);
  background: var(--bg-card);
  box-shadow: var(--shadow-card);
}

.stat-card {
  flex: 1;
  text-align: center;
}

.stat-label {
  color: var(--text-secondary);
  font-size: var(--wl-font-sm);
}

.stat-value {
  margin-top: 8rpx;
  color: var(--brand-color-dark);
  font-size: 48rpx;
  font-weight: 700;
  line-height: 1.1;
}

.stat-divider {
  width: 1rpx;
  margin: 4rpx 0;
  background: var(--border-color);
}

/* 敲击区 */
.altar-panel {
  position: relative;
  margin-top: var(--wl-card-gap);
  padding: var(--space-md) 18rpx var(--space-md);
  border: 1rpx solid var(--border-color);
  border-radius: var(--radius-large);
  overflow: hidden;
  background: var(--brand-color-light);
  box-shadow: var(--shadow-card);
  box-sizing: border-box;
}

/* 保留原装饰层次，改为浅色描边圆环 */
.halo {
  position: absolute;
  top: 76rpx;
  left: 50%;
  border: 1rpx solid #cfe4dd;
  border-radius: 50%;
  transform: translateX(-50%);
}

.halo-one {
  width: 430rpx;
  height: 430rpx;
}

.halo-two {
  top: 116rpx;
  width: 350rpx;
  height: 350rpx;
  border-color: #dcece7;
}

.wooden-fish-stage {
  position: relative;
  z-index: 2;
  width: 520rpx;
  height: 440rpx;
  margin: 0 auto;
  transform: translateZ(0);
  transition: opacity 80ms ease-out;
}

.wooden-fish-stage.stage-pressed {
  opacity: 0.9;
}

.fish-assembly {
  position: absolute;
  bottom: 56rpx;
  left: 50%;
  width: 430rpx;
  height: 311rpx;
  filter: drop-shadow(0 12rpx 18rpx rgba(20, 42, 37, 0.12));
  transform: translateX(-50%) scale(1);
  transform-origin: 54% 86%;
}

.fish-assembly.is-striking {
  animation: fish-hit 260ms ease-out;
}

.wooden-fish-image {
  display: block;
  width: 100%;
  height: 100%;
}

.mallet {
  position: absolute;
  z-index: 5;
  top: 12rpx;
  right: -10rpx;
  width: 310rpx;
  height: 58rpx;
  transform: rotate(-10deg);
  transform-origin: 94% 50%;
}

.mallet.is-striking {
  animation: mallet-hit 260ms ease-in-out;
}

.mallet-image {
  display: block;
  width: 100%;
  height: 100%;
  filter: drop-shadow(0 6rpx 8rpx rgba(20, 42, 37, 0.14));
}

.merit-float {
  position: absolute;
  z-index: 8;
  top: 72rpx;
  left: 50%;
  min-width: 180rpx;
  padding: 12rpx 24rpx;
  border-radius: var(--wl-radius-pill);
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 600;
  text-align: center;
  white-space: nowrap;
  background: rgba(43, 122, 104, 0.92);
  animation: merit-rise 360ms ease-out forwards;
  transform: translateX(-50%);
}

.tap-hint {
  position: relative;
  z-index: 3;
  color: var(--text-secondary);
  font-size: var(--wl-font-sm);
  text-align: center;
}

/* 设置区 */
.control-panel {
  margin-top: var(--wl-card-gap);
  padding: var(--space-md);
  border: 1rpx solid var(--border-color);
  border-radius: var(--radius-large);
  background: var(--bg-card);
  box-shadow: var(--shadow-card);
  box-sizing: border-box;
}

.control-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.control-copy {
  padding-right: 24rpx;
}

.control-title {
  color: var(--text-primary);
  font-size: var(--wl-font-md);
  font-weight: 600;
}

.control-desc {
  margin-top: 6rpx;
  color: var(--text-secondary);
  font-size: var(--wl-font-sm);
  line-height: 1.45;
}

.speed-list {
  display: flex;
  gap: var(--wl-space-sm);
  margin: var(--space-md) 0;
}

.speed-item {
  flex: 1;
  padding: 18rpx 12rpx;
  border: 1rpx solid var(--border-color);
  border-radius: var(--radius-medium);
  text-align: center;
  background: var(--bg-sub);
}

.speed-item.is-active {
  border-color: var(--brand-color);
  background: var(--brand-color-light);
}

.speed-name {
  color: var(--text-primary);
  font-size: var(--wl-font);
  font-weight: 600;
}

.speed-desc {
  margin-top: 4rpx;
  color: var(--text-placeholder);
  font-size: var(--wl-font-xs);
}

.speed-item.is-active .speed-name {
  color: var(--brand-color-dark);
}

.sound-row {
  padding-top: var(--space-md);
  border-top: 1rpx solid var(--border-color);
}

/* 次操作：沿用统一的按钮高度与圆角 */
.reset-action {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 88rpx;
  margin-top: var(--space-md);
  border-radius: 44rpx;
  color: var(--brand-color-dark);
  font-size: var(--wl-font-md);
  font-weight: 500;
  background: var(--brand-color-light);
}

.reset-action.reset-pressed {
  opacity: 0.72;
}

.footer-note {
  padding: var(--space-md) 16rpx 0;
  color: var(--text-placeholder);
  font-size: var(--wl-font-xs);
  line-height: 1.6;
  text-align: center;
}

@keyframes mallet-hit {
  0% { transform: rotate(-10deg); }
  48% { transform: rotate(-30deg); }
  100% { transform: rotate(-10deg); }
}

@keyframes fish-hit {
  0% { transform: translateX(-50%) scale(1); }
  42% { transform: translateX(-50%) scale(0.965, 0.94); }
  100% { transform: translateX(-50%) scale(1); }
}

@keyframes merit-rise {
  0% { opacity: 0; transform: translate(-50%, 24rpx) scale(0.88); }
  30% { opacity: 1; transform: translate(-50%, 0) scale(1); }
  100% { opacity: 0; transform: translate(-50%, -62rpx) scale(1.03); }
}
