page {
  background: var(--bg-page);
  color: var(--text-primary);
  height: 100vh;
  overflow: hidden;
}

.shell {
  display: flex;
  flex-direction: column;
  height: 100vh;
  overflow: hidden;
  background: var(--bg-page);
}

.page-scroll {
  flex: 1;
  height: 0;
  min-height: 0;
  background: var(--bg-page);
}

.page {
  min-height: 100%;
  padding: var(--space-md) var(--wl-page-padding) calc(48rpx + var(--wl-safe-bottom));
  box-sizing: border-box;
  background: var(--bg-page);
}
.field-row,
.field-icon,
.button-row,
.result-head,
.gauge-track,
.gauge-labels,
.ideal-card {
  display: flex;
}

.form-card,
.result-card {
  margin-top: 24rpx;
  padding: 30rpx;
  border-radius: 34rpx;
  box-sizing: border-box;
  background: #ffffff;
  box-shadow: 0 14rpx 32rpx rgba(34, 63, 57, 0.05);
}

.card-title {
  color: #19251f;
  font-size: 30rpx;
  font-weight: 700;
}

.field-list {
  margin-top: 24rpx;
}

.field-row {
  align-items: center;
  min-height: 122rpx;
  padding: 22rpx;
  border-radius: 28rpx;
  box-sizing: border-box;
  background: #f5f9f7;
}

.field-row + .field-row {
  margin-top: 18rpx;
}

.field-icon {
  flex: none;
  align-items: center;
  justify-content: center;
  width: 74rpx;
  height: 74rpx;
  border-radius: 20rpx;
}

.tone-height {
  background: #e7f0f7;
}

.tone-weight {
  background: #edf4fa;
}

.field-main {
  min-width: 0;
  flex: 1;
  margin-left: 22rpx;
}

.field-label {
  color: #7d8985;
  font-size: 23rpx;
}

.field-input {
  width: 100%;
  height: 52rpx;
  margin-top: 8rpx;
  color: #19251f;
  font-size: 34rpx;
  font-weight: 700;
}

.input-placeholder {
  color: #a1ada9;
  font-weight: 500;
}

.field-unit {
  flex: none;
  color: #7d8985;
  font-size: 25rpx;
  font-weight: 600;
}

.button-row {
  margin-top: 24rpx;
}

.calculate-button {
  --td-button-primary-bg-color: var(--brand-color);
  --td-button-primary-border-color: var(--brand-color);
  --td-button-primary-active-bg-color: var(--brand-color-dark);
  --td-button-primary-active-border-color: var(--brand-color-dark);
}

.result-card {
  overflow: hidden;
}

.result-head {
  align-items: flex-start;
  justify-content: space-between;
}

.result-label {
  color: #7d8985;
  font-size: 23rpx;
}

.result-value {
  margin-top: 4rpx;
  color: #142a25;
  font-size: 70rpx;
  font-weight: 700;
  line-height: 1.1;
}

.result-badge {
  min-width: 108rpx;
  height: 48rpx;
  padding: 0 20rpx;
  border-radius: 999rpx;
  background: #edf3f1;
  color: #7d8985;
  font-size: 24rpx;
  font-weight: 700;
  line-height: 48rpx;
  text-align: center;
}

.result-normal .result-badge {
  background: #e7f0f7;
  color: #2d6895;
}

.result-low .result-badge {
  background: #e7f0f7;
  color: #2d6895;
}

.result-high .result-badge {
  background: #f7efd9;
  color: #9a6a19;
}

.result-alert .result-badge {
  background: #f7e8e4;
  color: #a85b52;
}

.gauge {
  margin-top: 30rpx;
}

.gauge-track {
  position: relative;
  height: 18rpx;
  overflow: visible;
  border-radius: 999rpx;
}

.gauge-segment {
  flex: 1;
  height: 18rpx;
}

.segment-low {
  border-radius: 999rpx 0 0 999rpx;
  background: #b8d8ec;
}

.segment-normal {
  background: #77a9cf;
}

.segment-high {
  background: #e8ca7b;
}

.segment-alert {
  border-radius: 0 999rpx 999rpx 0;
  background: #dfa19a;
}

.gauge-marker {
  position: absolute;
  top: -12rpx;
  width: 20rpx;
  height: 42rpx;
  margin-left: -10rpx;
  border-radius: 999rpx;
  background: #142a25;
  box-shadow: 0 8rpx 16rpx rgba(20, 42, 37, 0.18);
}

.gauge-labels {
  justify-content: space-between;
  margin-top: 20rpx;
  color: #7d8985;
  font-size: 22rpx;
}

.result-detail {
  margin-top: 28rpx;
}

.result-desc {
  color: #5e716c;
  font-size: 26rpx;
  line-height: 1.5;
}

.ideal-card {
  align-items: center;
  justify-content: space-between;
  margin-top: 22rpx;
  padding: 22rpx 24rpx;
  border-radius: 26rpx;
  background: #f5f9f7;
}

.ideal-title {
  color: #7d8985;
  font-size: 24rpx;
}

.ideal-value {
  color: #19251f;
  font-size: 27rpx;
  font-weight: 700;
}

.reset-link {
  margin-top: 24rpx;
  color: #2d6895;
  font-size: 26rpx;
  font-weight: 700;
  text-align: center;
}

.result-empty {
  margin-top: 28rpx;
  color: #7d8985;
  font-size: 25rpx;
  line-height: 1.5;
}

@media (max-width: 360px) {
  .page {
    padding-left: 22rpx;
    padding-right: 22rpx;
  }
}

