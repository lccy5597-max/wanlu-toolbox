page {
  background: var(--bg-page);
  color: var(--text-primary);
  height: 100vh;
  overflow: hidden;
}

.shell {
  display: flex;
  flex-direction: column;
  height: 100vh;
  overflow: hidden;
  background: var(--bg-page);
}

.page-scroll {
  flex: 1;
  height: 0;
  min-height: 0;
  background: var(--bg-page);
}

.page {
  min-height: 100%;
  padding: var(--space-md) var(--wl-page-padding) calc(48rpx + var(--wl-safe-bottom));
  box-sizing: border-box;
  background: var(--bg-page);
}
.gender-selector,
.gender-chip,
.gender-chip-icon,
.path-card,
.path-segment,
.builder-actions,
.example-row,
.token-grid,
.result-head {
  display: flex;
}

.form-card,
.result-card {
  margin-top: 24rpx;
  padding: 30rpx;
  border-radius: 34rpx;
  box-sizing: border-box;
  background: #ffffff;
  box-shadow: 0 14rpx 32rpx rgba(63, 48, 44, 0.05);
}

.card-title {
  color: #19251f;
  font-size: 30rpx;
  font-weight: 700;
}

.gender-row {
  margin-top: 24rpx;
}

.gender-label,
.input-label,
.group-title,
.result-label {
  color: #84746f;
  font-size: 23rpx;
  font-weight: 600;
}

.gender-selector {
  margin-top: 16rpx;
  padding: 8rpx;
  border-radius: 999rpx;
  background: #f5ece8;
}

.gender-chip {
  flex: 1;
  height: 80rpx;
  border-radius: 999rpx;
  align-items: center;
  justify-content: center;
  color: #8b5a4a;
}

.gender-chip.active {
  color: #ffffff;
  background: linear-gradient(135deg, #9a6552, #8b5a4a);
  box-shadow: 0 10rpx 20rpx rgba(139, 90, 74, 0.16);
}

.gender-chip-icon {
  align-items: center;
  justify-content: center;
  width: 46rpx;
  height: 46rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.72);
}

.gender-chip.active .gender-chip-icon {
  background: rgba(255, 255, 255, 0.22);
}

.gender-chip-text {
  margin-left: 12rpx;
  font-size: 26rpx;
  font-weight: 700;
  color: #8b5a4a;
}

.gender-chip.active .gender-chip-text {
  color: #ffffff;
}

.builder-card {
  margin-top: 24rpx;
  padding: 24rpx;
  border-radius: 28rpx;
  background: linear-gradient(180deg, #f9f1ed 0%, #fbf7f5 100%);
}

.input-head {
  display: block;
}

.path-card {
  flex-wrap: wrap;
  align-items: center;
  margin-top: 12rpx;
}

.path-start,
.path-chip {
  flex: none;
  height: 54rpx;
  padding: 0 18rpx;
  border-radius: 999rpx;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #8b5a4a;
  font-size: 22rpx;
  font-weight: 700;
  background: #ffffff;
}

.path-segment {
  flex: none;
  align-items: center;
  margin-right: 12rpx;
  margin-bottom: 10rpx;
}

.path-arrow {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 54rpx;
  margin-right: 10rpx;
  color: #b19084;
  font-size: 24rpx;
  font-weight: 700;
}

.path-limit {
  margin-top: 12rpx;
  color: #8b5a4a;
  font-size: 21rpx;
  font-weight: 700;
  line-height: 1.45;
}

.builder-actions {
  margin-top: 18rpx;
}

.builder-action {
  flex: 1;
  min-width: 0;
  height: 72rpx;
  border-radius: 22rpx;
  box-sizing: border-box;
  color: #8b5a4a;
  font-size: 24rpx;
  font-weight: 700;
  line-height: 72rpx;
  text-align: center;
  background: rgba(255, 255, 255, 0.96);
  box-shadow: inset 0 0 0 2rpx rgba(139, 90, 74, 0.1);
}

.builder-action-clear {
  color: #8b5a4a;
  background: rgba(255, 255, 255, 0.98);
  box-shadow: inset 0 0 0 2rpx rgba(139, 90, 74, 0.1);
}

.builder-action-delete {
  color: #6d4b40;
  background: rgba(245, 232, 226, 0.98);
  box-shadow: inset 0 0 0 2rpx rgba(139, 90, 74, 0.14);
}

.builder-action + .builder-action {
  margin-left: 16rpx;
}

.helper-banner {
  margin-top: 18rpx;
  padding: 18rpx 22rpx;
  border-radius: 22rpx;
  color: #8f7c75;
  font-size: 22rpx;
  line-height: 1.5;
  background: #f6efeb;
}

.inline-result-card {
  margin-top: 18rpx;
  padding: 24rpx;
  background: #ffffff;
  box-shadow: none;
}

.example-row {
  flex-wrap: wrap;
  margin-top: 20rpx;
}

.example-chip,
.token-chip {
  flex: none;
  height: 54rpx;
  padding: 0 18rpx;
  margin-right: 12rpx;
  margin-bottom: 12rpx;
  border-radius: 999rpx;
  box-sizing: border-box;
  color: #8b5a4a;
  font-size: 22rpx;
  font-weight: 700;
  line-height: 54rpx;
  background: #f8ece7;
}

.relation-groups {
  margin-top: 10rpx;
}

.group-card {
  margin-top: 18rpx;
}

.token-grid {
  flex-wrap: wrap;
  margin-top: 12rpx;
}

.token-chip {
  background: #f5f0ed;
  color: #6f5a53;
}

.result-head {
  align-items: flex-start;
  justify-content: space-between;
}

.result-value {
  margin-top: 8rpx;
  color: #1f2622;
  font-size: 56rpx;
  font-weight: 700;
  line-height: 1.1;
}

.result-badge {
  min-width: 112rpx;
  height: 48rpx;
  padding: 0 20rpx;
  border-radius: 999rpx;
  background: #f5ece8;
  color: #8b5a4a;
  font-size: 24rpx;
  font-weight: 700;
  line-height: 48rpx;
  text-align: center;
}

.result-empty {
  margin-top: 28rpx;
  color: #84746f;
  font-size: 25rpx;
  line-height: 1.5;
}

@media (max-width: 360px) {
  .page {
    padding-left: 22rpx;
    padding-right: 22rpx;
  }

  .gender-chip-text {
    font-size: 24rpx;
  }

  .result-value {
    font-size: 48rpx;
  }
}
