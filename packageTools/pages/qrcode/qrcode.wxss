/* 二维码生成页 —— 骨架/卡片/按钮复用 styles/common.wxss 的统一模板类 */

/* 页面骨架：与其余工具页保持完全一致
   page 定高 + .shell 纵向 flex，导航条占自然高度、滚动区吃掉剩余高度。
   这样既不会出现「页面整体滚动 + 内部再滚动」的双滚动，也不会把底部内容顶出屏幕。 */
page {
  background: var(--bg-page);
  color: var(--text-primary);
  height: 100vh;
  overflow: hidden;
}

.shell {
  display: flex;
  flex-direction: column;
  height: 100vh;
  overflow: hidden;
  background: var(--bg-page);
}

.page-scroll {
  flex: 1;
  height: 0;
  min-height: 0;
  background: var(--bg-page);
}

.page {
  min-height: 100%;
  padding: var(--space-md) var(--wl-page-padding) calc(48rpx + var(--wl-safe-bottom));
  box-sizing: border-box;
  background: var(--bg-page);
}

.export-canvas {
  position: fixed;
  left: -3000px;
  top: -3000px;
  width: 300px;
  height: 300px;
}

/* 输入区 */
.content-textarea {
  width: 100%;
  min-height: 180rpx;
  color: var(--text-primary);
  font-size: var(--wl-font);
  line-height: 1.55;
  box-sizing: border-box;
}

.textarea-placeholder {
  color: var(--text-placeholder);
}

.clear-button {
  margin-right: var(--wl-space-sm);
  padding: 4rpx 16rpx;
  border-radius: var(--radius-small);
  background: var(--wl-surface-sub);
  color: var(--text-secondary);
  font-size: var(--wl-font-xs);
}

.char-count {
  color: var(--text-placeholder);
  font-size: var(--wl-font-xs);
}

/* Logo 选择 */
.logo-uploader {
  display: flex;
  align-items: center;
  min-height: 108rpx;
  padding: var(--space-md);
  border-radius: var(--radius-medium);
  border: 2rpx dashed var(--wl-border-strong);
  background: var(--wl-surface-sub);
  box-sizing: border-box;
}

.upload-copy {
  flex: 1;
  min-width: 0;
  margin-left: var(--space-md);
}

.upload-title {
  color: var(--text-primary);
  font-size: var(--wl-font);
  font-weight: 500;
}

.upload-desc {
  margin-top: 6rpx;
  color: var(--text-placeholder);
  font-size: var(--wl-font-xs);
}

.logo-preview {
  display: flex;
  align-items: center;
  min-height: 108rpx;
  padding: var(--space-md);
  border-radius: var(--radius-medium);
  background: var(--wl-surface-sub);
  box-sizing: border-box;
}

.logo-image {
  flex: none;
  width: 76rpx;
  height: 76rpx;
  border-radius: var(--radius-small);
  background: var(--bg-card);
}

.logo-info {
  flex: 1;
  min-width: 0;
  margin-left: var(--space-md);
}

.logo-title {
  color: var(--text-primary);
  font-size: var(--wl-font);
  font-weight: 500;
}

.logo-desc {
  margin-top: 6rpx;
  color: var(--text-secondary);
  font-size: var(--wl-font-xs);
}

.logo-remove {
  flex: none;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: var(--bg-card);
}

/* 结果卡：
   - 标题与二维码之间收紧，让二维码整体略微上移
   - 舞台区采用较小的最小高度，高度随内容自适应，避免大面积空白
   - 不再额外补底部内边距，统一走 .wl-card 的 24rpx */
.result-card .wl-card-head {
  margin-bottom: var(--space-sm);
}

.result-meta {
  color: var(--text-secondary);
  font-size: var(--wl-font-xs);
}

.result-stage {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  min-height: 380rpx;
  padding: var(--space-sm);
  border-radius: var(--radius-medium);
  background: var(--bg-card);
  box-shadow: inset 0 0 0 1rpx var(--border-color);
  box-sizing: border-box;
  overflow: hidden;
}

/* 二维码预览：纯 <image>，按屏宽百分比自适应（400rpx ≈ 53% 屏宽） */
.qr-image {
  width: 400rpx;
  height: 400rpx;
}

.result-loading {
  display: flex;
  flex-direction: column;
  align-items: center;
  color: var(--text-secondary);
}

.result-loading-text {
  margin-top: var(--wl-space-sm);
  font-size: var(--wl-font-sm);
}

/* 提示文案贴近二维码，不与按钮区域挤在一起 */
.result-tip {
  margin-top: var(--space-sm);
  color: var(--text-placeholder);
  font-size: var(--wl-font-xs);
  text-align: center;
}

.result-actions {
  display: flex;
  gap: var(--space-md);
  margin-top: var(--space-md);
}

.result-action-main {
  flex: 1.4;
  --td-button-primary-bg-color: var(--brand-color);
  --td-button-primary-border-color: var(--brand-color);
  --td-button-primary-active-bg-color: var(--brand-color-dark);
  --td-button-primary-active-border-color: var(--brand-color-dark);
  --td-button-large-height: 88rpx;
  --td-button-border-radius: 44rpx;
}

.result-action-sub {
  flex: 1;
  --td-button-default-bg-color: var(--brand-color-light);
  --td-button-default-border-color: var(--brand-color-light);
  --td-button-default-color: var(--brand-color-dark);
  --td-button-default-active-bg-color: #d8eae4;
  --td-button-default-active-border-color: #d8eae4;
  --td-button-large-height: 88rpx;
  --td-button-border-radius: 44rpx;
}
