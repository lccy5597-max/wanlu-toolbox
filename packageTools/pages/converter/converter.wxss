page {
  background: var(--bg-page);
  color: var(--text-primary);
  height: 100vh;
  overflow: hidden;
}

.shell {
  display: flex;
  flex-direction: column;
  height: 100vh;
  overflow: hidden;
  background: var(--bg-page);
}

.page-scroll {
  flex: 1;
  height: 0;
  min-height: 0;
  background: var(--bg-page);
}

.page {
  min-height: 100%;
  padding: var(--space-md) var(--wl-page-padding) calc(48rpx + var(--wl-safe-bottom));
  box-sizing: border-box;
  background: var(--bg-page);
}
.category-grid,
.unit-head,
.unit-picker,
.value-row,
.swap-row,
.swap-button,
.result-row,
.button-row,
.reference-row {
  display: flex;
}

.form-card,
.reference-card {
  margin-top: 24rpx;
  padding: 30rpx;
  border-radius: 34rpx;
  box-sizing: border-box;
  background: #ffffff;
  box-shadow: 0 14rpx 32rpx rgba(63, 48, 44, 0.05);
}

.card-title {
  color: #19251f;
  font-size: 30rpx;
  font-weight: 700;
}

.category-grid {
  flex-wrap: wrap;
  margin-top: 24rpx;
}

.category-item {
  width: 31.8%;
  height: 64rpx;
  margin-right: 2.3%;
  margin-bottom: 16rpx;
  border: 1rpx solid #eee5e0;
  border-radius: 999rpx;
  box-sizing: border-box;
  color: #7e706c;
  font-size: 24rpx;
  font-weight: 700;
  line-height: 62rpx;
  text-align: center;
  background: #fbf8f7;
}

.category-item:nth-child(3n) {
  margin-right: 0;
}

.category-item.is-active {
  border-color: rgba(43, 122, 104, 0.3);
  color: var(--brand-color);
  background: var(--brand-color-light);
}

.converter-panel {
  margin-top: 6rpx;
}

.unit-card {
  padding: 24rpx;
  border-radius: 28rpx;
  box-sizing: border-box;
  background: #f8f5f3;
}

.result-unit-card {
  background: #f9efed;
}

.unit-head {
  align-items: center;
  justify-content: space-between;
}

.unit-label {
  color: #84746f;
  font-size: 23rpx;
}

.unit-picker {
  align-items: center;
  height: 44rpx;
  padding: 0 16rpx;
  border-radius: 999rpx;
  color: var(--brand-color);
  font-size: 23rpx;
  font-weight: 700;
  line-height: 44rpx;
  background: #ffffff;
}

.value-row,
.result-row {
  align-items: flex-end;
  margin-top: 18rpx;
}

.value-input {
  flex: 1;
  min-width: 0;
  height: 72rpx;
  color: #19251f;
  font-size: 48rpx;
  font-weight: 700;
}

.input-placeholder {
  color: #b0a39f;
  font-weight: 500;
}

.result-value {
  flex: 1;
  min-width: 0;
  color: #142a25;
  font-size: 52rpx;
  font-weight: 700;
  line-height: 1.1;
  word-break: break-all;
}

.value-symbol {
  flex: none;
  margin-left: 18rpx;
  color: #84746f;
  font-size: 26rpx;
  font-weight: 700;
  line-height: 1.6;
}

.swap-row {
  justify-content: center;
  margin: 18rpx 0;
}

.swap-button {
  align-items: center;
  justify-content: center;
  width: 72rpx;
  height: 72rpx;
  border-radius: 999rpx;
  background: #ffffff;
  box-shadow: 0 12rpx 28rpx rgba(91, 51, 45, 0.1);
}

.button-row {
  margin-top: 24rpx;
}

.clear-button {
  --td-button-default-color: var(--brand-color);
  --td-button-default-bg-color: var(--brand-color-light);
  --td-button-default-border-color: var(--brand-color-light);
  --td-button-default-active-bg-color: #efd6d1;
  --td-button-default-active-border-color: #efd6d1;
}

.reference-list {
  margin-top: 18rpx;
}

.reference-row {
  align-items: center;
  justify-content: space-between;
  min-height: 64rpx;
}

.reference-row + .reference-row {
  border-top: 1rpx solid #eee5e0;
}

.reference-label {
  color: #84746f;
  font-size: 24rpx;
}

.reference-value {
  color: #19251f;
  font-size: 25rpx;
  font-weight: 700;
  text-align: right;
}

@media (max-width: 360px) {
  .page {
    padding-left: 22rpx;
    padding-right: 22rpx;
  }

  .value-input,
  .result-value {
    font-size: 44rpx;
  }

  .category-item {
    font-size: 22rpx;
  }
}

