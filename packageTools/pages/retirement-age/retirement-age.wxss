page {
  background: var(--bg-page);
  color: var(--text-primary);
  height: 100vh;
  overflow: hidden;
}

.shell {
  display: flex;
  flex-direction: column;
  height: 100vh;
  overflow: hidden;
  background: var(--bg-page);
}

.page-scroll {
  flex: 1;
  height: 0;
  min-height: 0;
  background: var(--bg-page);
}

.page {
  min-height: 100%;
  padding: var(--space-md) var(--wl-page-padding) calc(48rpx + var(--wl-safe-bottom));
  box-sizing: border-box;
  background: var(--bg-page);
}
.field-row,
.field-icon,
.type-row,
.helper-note,
.button-row,
.result-head,
.summary-grid {
  display: flex;
}

.form-card,
.result-card {
  margin-top: 24rpx;
  padding: 30rpx;
  border-radius: 34rpx;
  box-sizing: border-box;
  background: #ffffff;
  box-shadow: 0 14rpx 32rpx rgba(42, 69, 84, 0.05);
}

.card-title {
  color: #14242a;
  font-size: 30rpx;
  font-weight: 700;
}

.field-list {
  margin-top: 24rpx;
}

.field-row {
  align-items: center;
  min-height: 122rpx;
  padding: 22rpx;
  border-radius: 28rpx;
  box-sizing: border-box;
  background: #f6fbff;
}

.field-icon {
  flex: none;
  align-items: center;
  justify-content: center;
  width: 74rpx;
  height: 74rpx;
  border-radius: 20rpx;
}

.tone-date {
  background: #e8f4fb;
}

.field-main {
  min-width: 0;
  flex: 1;
  margin-left: 22rpx;
}

.field-label,
.type-label,
.result-label,
.summary-label {
  color: #768992;
  font-size: 23rpx;
}

.field-picker {
  display: block;
}

.picker-value {
  width: 100%;
  min-height: 52rpx;
  margin-top: 8rpx;
  color: #a7b5bc;
  font-size: 34rpx;
  font-weight: 700;
  line-height: 52rpx;
}

.picker-value.has-value {
  color: #14242a;
}

.type-panel {
  margin-top: 24rpx;
  padding: 24rpx;
  border-radius: 28rpx;
  background: #f6fbff;
}

.type-row {
  justify-content: space-between;
  margin-top: 14rpx;
}

.type-chip {
  width: calc(33.333% - 10rpx);
  min-height: 86rpx;
  padding: 14rpx 8rpx;
  border-radius: 22rpx;
  box-sizing: border-box;
  background: #ffffff;
  text-align: center;
}

.type-chip.active {
  color: #ffffff;
  background: #2d6895;
  box-shadow: 0 10rpx 20rpx rgba(45, 104, 149, 0.16);
}

.type-main {
  font-size: 22rpx;
  font-weight: 700;
  line-height: 1.3;
}

.type-sub {
  margin-top: 6rpx;
  color: #768992;
  font-size: 19rpx;
  font-weight: 700;
}

.type-chip.active .type-sub {
  color: rgba(255, 255, 255, 0.76);
}

.helper-note {
  align-items: center;
  margin-top: 24rpx;
  padding: 20rpx 24rpx;
  border-radius: 24rpx;
  background: #eaf4fb;
  color: #60727b;
  font-size: 22rpx;
  line-height: 1.55;
}

.button-row {
  margin-top: 24rpx;
}

.calculate-button {
  --td-button-primary-bg-color: var(--brand-color);
  --td-button-primary-border-color: var(--brand-color);
  --td-button-primary-active-bg-color: var(--brand-color-dark);
  --td-button-primary-active-border-color: var(--brand-color-dark);
}

.result-head {
  align-items: flex-start;
  justify-content: space-between;
}

.result-value {
  margin-top: 8rpx;
  color: #14242a;
  font-size: 56rpx;
  font-weight: 700;
  line-height: 1.1;
}

.result-badge {
  max-width: 240rpx;
  min-height: 48rpx;
  padding: 0 20rpx;
  border-radius: 999rpx;
  background: #eaf4fb;
  color: #2d6895;
  font-size: 23rpx;
  font-weight: 700;
  line-height: 48rpx;
  text-align: center;
}

.summary-grid {
  flex-wrap: wrap;
  justify-content: space-between;
  margin-top: 28rpx;
}

.summary-item {
  width: calc(50% - 9rpx);
  margin-bottom: 18rpx;
  padding: 24rpx;
  border-radius: 26rpx;
  box-sizing: border-box;
  background: #f6fbff;
}

.summary-value {
  margin-top: 10rpx;
  color: #14242a;
  font-size: 28rpx;
  font-weight: 700;
  line-height: 1.35;
}

.detail-card {
  margin-top: 4rpx;
  padding: 24rpx;
  border-radius: 26rpx;
  background: #f6fbff;
}

.detail-note {
  color: #60727b;
  font-size: 22rpx;
  line-height: 1.55;
}

.detail-note + .detail-note {
  margin-top: 14rpx;
}

.result-empty {
  margin-top: 28rpx;
  color: #768992;
  font-size: 25rpx;
  line-height: 1.5;
}

.reset-link {
  margin-top: 24rpx;
  color: #2d6895;
  font-size: 26rpx;
  font-weight: 700;
  text-align: center;
}

@media (max-width: 360px) {
  .page {
    padding-left: 22rpx;
    padding-right: 22rpx;
  }

  .result-value {
    font-size: 48rpx;
  }

  .summary-item,
  .type-chip {
    width: 100%;
  }

  .type-row {
    display: block;
  }

  .type-chip + .type-chip {
    margin-top: 14rpx;
  }
}
