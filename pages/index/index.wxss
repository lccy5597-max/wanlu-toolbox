/* pages/index/index.wxss */
/* 页面骨架：page 定高 + .page 纵向 flex。
   导航条在 flex 里占自然高度，滚动区吃掉剩余高度，
   避免「100vh 滚动区被导航栏顶出屏幕底部」导致的底部内容无法触达。 */
page {
  height: 100vh;
  overflow: hidden;
}

.page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  overflow: hidden;
  /* 覆盖 common.wxss 全局 .page 的底部安全区内边距：
     Tab 页下方已有 TabBar，不需要再留出 home 指示条空间 */
  padding: 0;
}

.page-scroll {
  flex: 1;
  height: 0;
  min-height: 0;
}

/* 顶部品牌区 */
.header {
  padding: 8rpx var(--wl-page-padding) 24rpx;
  background: linear-gradient(180deg, #eef4f2 0%, var(--wl-bg) 100%);
}

.brand {
  padding: 12rpx 0 20rpx;
}

.brand-name {
  font-size: var(--wl-font-xxl);
  font-weight: 700;
  color: var(--wl-text);
  letter-spacing: 1rpx;
}

.brand-slogan {
  margin-top: 8rpx;
  font-size: var(--wl-font-sm);
  color: var(--wl-text-sub);
}

.search {
  display: block;
}

.search-input {
  background: var(--wl-surface);
  border-radius: var(--wl-radius-pill);
  box-shadow: var(--wl-shadow-card);
}

.stats {
  display: flex;
  align-items: center;
  margin-top: 20rpx;
  font-size: var(--wl-font-sm);
  color: var(--wl-text-weak);
}

.stats-dot {
  margin: 0 10rpx;
}

/* 高频工具九宫格 */
.quick-section {
  padding: 8rpx var(--wl-page-padding) 0;
}

.quick-grid {
  display: flex;
  flex-wrap: wrap;
  padding: 20rpx 10rpx 0;
  background: var(--wl-surface);
  border-radius: var(--wl-radius-lg);
  box-shadow: var(--wl-shadow-card);
}

.quick-cell {
  width: 25%;
  padding: 0 10rpx 20rpx;
}

/* 区块 */
.block {
  margin-top: var(--wl-space-lg);
}

.hot-list {
  display: flex;
  flex-direction: column;
  padding: var(--wl-space) var(--wl-page-padding) 0;
}

.hot-list .list {
  margin-bottom: var(--wl-card-gap);
}

.search-result-bar {
  padding: 20rpx var(--wl-page-padding) 12rpx;
}

.search-result-text {
  font-size: var(--wl-font-sm);
  color: var(--wl-text-weak);
}

.search-result-list {
  display: flex;
  flex-direction: column;
  padding: 0 var(--wl-page-padding);
}

.search-result-list .list {
  margin-bottom: var(--wl-card-gap);
}

.search-empty-wrap {
  padding: 0 var(--wl-page-padding);
}

.footer-space {
  height: 40rpx;
}
