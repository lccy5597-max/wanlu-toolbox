<view class="page">
  <navigation-bar title="{{brand.name}}" back="{{false}}" color="#1f2729" background="#f4f6f8"></navigation-bar>

  <scroll-view class="page-scroll" scroll-y enhanced show-scrollbar="{{false}}">
    <!-- 顶部品牌区 + 搜索 -->
    <view class="header">
      <view class="brand">
        <view class="brand-name">{{brand.name}}</view>
        <view class="brand-slogan">{{brand.slogan}}</view>
      </view>

      <t-search
        class="search"
        t-class-input-container="search-input"
        value="{{inputSearchKeyword}}"
        placeholder="想用什么工具？搜一下"
        shape="round"
        clearable
        bind:change="onSearchInput"
        bind:clear="onSearchClear"
        bind:submit="onSearchSubmit"
      />

      <view class="stats">
        <text class="stats-item">共 {{totalToolCount}} 个工具</text>
        <text class="stats-dot">·</text>
        <text class="stats-item">图片处理 {{imageToolCount}}</text>
        <text class="stats-dot">·</text>
        <text class="stats-item">计算 {{calcToolCount}}</text>
      </view>
    </view>

    <block wx:if="{{isSearching}}">
      <view class="search-result-bar">
        <text class="search-result-text">“{{searchKeyword}}” 共 {{searchResults.length}} 个结果</text>
      </view>

      <view class="search-result-list" wx:if="{{searchResults.length}}">
        <tool-card
          wx:for="{{searchResults}}"
          wx:key="id"
          tool="{{item}}"
          mode="list"
          bind:tap="onToolTap"
        />
      </view>

      <view wx:else class="search-empty-wrap">
        <empty-state
          icon="search"
          title="没有找到相关工具"
          desc="换个关键词试试"
        />
      </view>
    </block>

    <block wx:else>
      <!-- 第一屏高频工具 -->
      <view class="quick-section">
        <view class="quick-grid">
          <view class="quick-cell" wx:for="{{quickTools}}" wx:key="id">
            <tool-card tool="{{item}}" mode="grid" bind:tap="onToolTap" />
          </view>
        </view>
      </view>

      <!-- 热门工具 -->
      <view class="block">
        <section-header title="热门工具" subtitle="大家最近常用的工具" showMore moreText="全部" bind:more="onViewAllTools" />
        <view class="hot-list">
          <tool-card
            wx:for="{{hotTools}}"
            wx:key="id"
            tool="{{item}}"
            mode="list"
            bind:tap="onToolTap"
          />
        </view>
      </view>
    </block>

    <view class="footer-space"></view>
  </scroll-view>
</view>
