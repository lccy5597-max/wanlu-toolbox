<view class="page">
  <navigation-bar title="我的" back="{{false}}" color="#1f2729" background="#f4f6f8"></navigation-bar>

  <scroll-view class="page-scroll" scroll-y enhanced show-scrollbar="{{false}}">
    <view class="brand-card card">
      <view class="brand-mark">挽</view>
      <view class="brand-copy">
        <view class="brand-name">{{brand.name}}</view>
        <view class="brand-desc">{{brand.desc}}</view>
      </view>
    </view>

    <view class="summary-grid">
      <view class="summary-item card"><view class="summary-value">{{summary.favorites}}</view><view class="summary-label">收藏</view></view>
      <view class="summary-item card"><view class="summary-value">{{summary.history}}</view><view class="summary-label">浏览</view></view>
      <view class="summary-item card"><view class="summary-value">{{summary.recent}}</view><view class="summary-label">最近使用</view></view>
    </view>

    <view class="section-label">本地数据</view>
    <view class="entry-list card">
      <view wx:for="{{dataEntries}}" wx:key="id" class="entry {{index === dataEntries.length - 1 ? 'is-last' : ''}}" data-path="{{item.path}}" bindtap="onDataEntryTap">
        <view class="entry-icon icon-wrap tone-{{item.tone}}"><t-icon name="{{item.icon}}" size="36rpx" color="{{item.iconColor}}" /></view>
        <view class="entry-main"><view class="entry-title">{{item.title}}</view><view class="entry-desc text-ellipsis">{{item.desc}}</view></view>
        <t-icon name="chevron-right" size="28rpx" color="#94a0a5" />
      </view>
    </view>

    <view class="section-label">帮助与关于</view>
    <view class="entry-list card">
      <view
        wx:for="{{serviceEntries}}"
        wx:key="id"
        class="entry {{index === serviceEntries.length - 1 ? 'is-last' : ''}}"
        data-item="{{item}}"
        bindtap="onItemTap"
      >
        <view class="entry-icon icon-wrap tone-{{item.tone}}">
          <t-icon name="{{item.icon}}" size="36rpx" color="{{item.iconColor}}" />
        </view>
        <view class="entry-main">
          <view class="entry-title">{{item.title}}</view>
          <view class="entry-desc text-ellipsis">{{item.desc}}</view>
        </view>
        <t-icon name="chevron-right" size="28rpx" color="#94a0a5" />
      </view>
    </view>

    <view class="feedback card">
      <button class="feedback-btn" open-type="contact" session-from="mine_page">
        <view class="entry-icon icon-wrap tone-mint">
          <t-icon name="chat-bubble-help" size="36rpx" color="#2f7567" />
        </view>
        <view class="entry-main">
          <view class="entry-title">意见反馈</view>
          <view class="entry-desc">遇到问题或想加新工具，可以直接反馈</view>
        </view>
      </button>
    </view>

    <view class="footer">
      <view class="footer-name">{{brand.name}} · {{brand.nameEn}}</view>
      <view class="footer-desc">{{brand.slogan}}</view>
    </view>
  </scroll-view>
</view>
