        "pages/long-image/long-image",
        "pages/nine-grid/nine-grid",
        "pages/video-compress/video-compress",
        "pages/converter/converter",
        "pages/date-diff/date-diff",
        "pages/mortgage/mortgage",
        "pages/salary/salary",
        "pages/retirement-pension/retirement-pension",
        "pages/retirement-age/retirement-age",
        "pages/compound/compound",
        "pages/price-compare/price-compare",
        "pages/shelf-life/shelf-life",
        "pages/relationship/relationship",
        "pages/restaurant/restaurant",
        "pages/bmi/bmi",
        "pages/bmr/bmr",
        "pages/ruler/ruler",
        "pages/choice-helper/choice-helper",
        "pages/pindou/pindou",
        "pages/guide/guide"
