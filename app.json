    },
    {
      "root": "packageAI",
      "name": "ai",
      "pages": [
        "pages/index/index"
      ]
    },
    {
      "root": "packageGithub",
      "name": "github",
      "pages": [
        "pages/index/index"
      ]
    },
    {
      "root": "packageUser",
      "name": "user",
      "pages": [
        "pages/favorites/favorites",
        "pages/history/history",
        "pages/recent/recent",
        "pages/data-management/data-management"
      ]
    }
  ],
  "preloadRule": {
    "pages/tools/tools": {
      "network": "all",
      "packages": [
        "packageTools"
      ]
    },
    "pages/index/index": {
      "network": "wifi",
      "packages": [
        "packageTools"
      ]
    }
  },
  "window": {
    "backgroundTextStyle": "light",
    "navigationBarBackgroundColor": "#ffffff",
    "navigationBarTitleText": "挽鹿工具箱",
    "navigationBarTextStyle": "black",
    "backgroundColor": "#f4f6f8",
    "navigationStyle": "custom"
  },
  "tabBar": {
    "color": "#8b949b",
    "selectedColor": "#2b7a68",
    "backgroundColor": "#ffffff",
    "borderStyle": "white",
    "list": [
      {
        "pagePath": "pages/index/index",
        "text": "首页",
        "iconPath": "assets/icons/tab/home.png",
        "selectedIconPath": "assets/icons/tab/home-active.png"
      },
      {
        "pagePath": "pages/tools/tools",
        "text": "工具",
        "iconPath": "assets/icons/tab/tools.png",
        "selectedIconPath": "assets/icons/tab/tools-active.png"
      },
      {
        "pagePath": "pages/discover/discover",
        "text": "发现",
        "iconPath": "assets/icons/tab/discover.png",
        "selectedIconPath": "assets/icons/tab/discover-active.png"
      },
      {
        "pagePath": "pages/mine/mine",
        "text": "我的",
        "iconPath": "assets/icons/tab/mine.png",
        "selectedIconPath": "assets/icons/tab/mine-active.png"
      }
    ]
  },
  "permission": {
    "scope.writePhotosAlbum": {
      "desc": "用于保存生成或处理后的图片、视频到相册"
    }
  },
  "__usePrivacyCheck__": true,
  "sitemapLocation": "sitemap.json",
  "lazyCodeLoading": "requiredComponents"
}
